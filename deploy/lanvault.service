[Unit]
Description=lanvault secrets server (LAN)
Documentation=https://github.com/NinjaSln-labs/lanvault/blob/master/docs/lan-client.md
Documentation=https://github.com/NinjaSln-labs/lanvault/blob/master/docs/systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Example for a personal single-host install (often root on a small box / WSL).
# Change LANVAULT_DIR / PASSWORD_FILE (and add User=) for your account.
# 0.0.0.0 exposes the API on all interfaces — use 127.0.0.1 if only local clients.
Environment=LANVAULT_DIR=/root/.lanvault
Environment=LANVAULT_PASSWORD_FILE=/root/.lanvault/master.pass
ExecStart=/usr/local/bin/lanvault serve --listen 0.0.0.0:8787
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

# Log to journal: journalctl -u lanvault -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
